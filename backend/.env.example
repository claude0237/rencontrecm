# Configuration SMTP pour l'envoi d'emails
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_ou_app_password
SMTP_FROM=noreply@rencontrescm.com

# Configuration SMS (choisir un fournisseur)
SMS_PROVIDER=none  # Options: 'twilio', 'africastalking', 'none'

# Configuration Twilio (si SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=votre_account_sid
TWILIO_AUTH_TOKEN=votre_auth_token
TWILIO_FROM_NUMBER=+237XXXXXXXXX

# Configuration Africa's Talking (si SMS_PROVIDER=africastalking)
AFRICASTALKING_USERNAME=votre_username
AFRICASTALKING_API_KEY=votre_api_key
